# Backend only. Never expose these values through Angular or public Vercel variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CORNERSCOUT_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Optional portable data directory; defaults to ./data.
# CORNERSCOUT_DATA_DIR=./data

# Vercel Services only (configure in the dashboard, never commit real values).
# CORNERSCOUT_SAME_ORIGIN=1
# CORNERSCOUT_STATELESS_RUNS=1
# CORNERSCOUT_SESSION_SECRET=generate_at_least_32_random_characters
# CORNERSCOUT_DATA_ARCHIVE_URL=https://public-host.example/vercel-canonical-data.zip
# CORNERSCOUT_DATA_ARCHIVE_SHA256=sha256_printed_by_packaging_script
