{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "projects": {"cornerscout": {"projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": {"builder": "@angular/build:application", "options": {"browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"], "assets": [{"glob": "**/*", "input": "public"}], "outputPath": "dist/cornerscout"}, "configurations": {"production": {"outputHashing": "all", "budgets": [{"type": "initial", "maximumWarning": "700kB", "maximumError": "1MB"}]}, "development": {"optimization": false, "sourceMap": true}}, "defaultConfiguration": "production"},
      "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "cornerscout:build:development", "proxyConfig": "proxy.conf.json"}}
    }
  }}, "cli": {"analytics": false}
}
