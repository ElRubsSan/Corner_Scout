  "components": {
    "schemas": {
      "Claim": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 1,
            "title": "Text"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "evidence_ids"
        ],
        "title": "Claim"
      },
      "Corner": {
        "properties": {
          "match_id": {
            "type": "integer",
            "title": "Match Id"
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "player": {
            "type": "string",
            "title": "Player"
          },
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "end_x": {
            "type": "number",
            "title": "End X"
          },
          "end_y": {
            "type": "number",
            "title": "End Y"
          },
          "side": {
            "type": "string",
            "title": "Side"
          },
          "delivery": {
            "type": "string",
            "title": "Delivery"
          },
          "zone": {
            "type": "string",
            "title": "Zone"
          },
          "height": {
            "type": "string",
            "title": "Height"
          },
          "shot_within_15s": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shot Within 15S"
          },
          "xg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Xg"
          },
          "valid_sequence": {
            "type": "boolean",
            "title": "Valid Sequence"
          },
          "spatial_valid": {
            "type": "boolean",
            "title": "Spatial Valid"
          },
          "end_reason": {
            "type": "string",
            "title": "End Reason"
          },
          "shot_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Shot Ids"
          },
          "restart_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Restart Ids"
          },
          "possession_change_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Possession Change Ids"
          },
          "cluster": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cluster"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "match_id",
          "event_id",
          "player",
          "x",
          "y",
          "end_x",
          "end_y",
          "side",
          "delivery",
          "zone",
          "height",
          "shot_within_15s",
          "xg",
          "valid_sequence",
          "spatial_valid",
          "end_reason",
          "shot_ids",
          "restart_ids",
          "possession_change_ids"
        ],
        "title": "Corner"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "event_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Event Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "description",
          "value"
        ],
        "title": "Evidence"
      },
      "Group": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "count"
        ],
        "title": "Group"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Match": {
        "properties": {
          "match_id": {
            "type": "integer",
            "title": "Match Id"
          },
          "match_date": {
            "type": "string",
            "title": "Match Date"
          },
          "kick_off": {
            "type": "string",
            "title": "Kick Off"
          },
          "home_team": {
            "type": "string",
            "title": "Home Team"
          },
          "away_team": {
            "type": "string",
            "title": "Away Team"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "match_id",
          "match_date",
          "kick_off",
          "home_team",
          "away_team"
        ],
        "title": "Match"
      },
      "ModelResult": {
        "properties": {
          "served": {
            "type": "string",
            "title": "Served"
          },
          "probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability"
          },
          "evaluation_scope": {
            "type": "string",
            "title": "Evaluation Scope"
          },
          "evaluations": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evaluations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "served",
          "probability",
          "evaluation_scope",
          "evaluations"
        ],
        "title": "ModelResult"
      },
      "Narrative": {
        "properties": {
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Observations"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Recommendations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "observations",
          "recommendations"
        ],
        "title": "Narrative"
      },
      "Pattern": {
        "properties": {
          "cluster": {
            "type": "integer",
            "title": "Cluster"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "evaluable": {
            "type": "integer",
            "title": "Evaluable"
          },
          "scr15": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scr15"
          },
          "xg_per_corner": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Xg Per Corner"
          },
          "dominant_zone": {
            "type": "string",
            "title": "Dominant Zone"
          },
          "main_taker": {
            "type": "string",
            "title": "Main Taker"
          },
          "example_event_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Example Event Ids"
          },
          "snapshot": {
            "type": "string",
            "title": "Snapshot"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cluster",
          "count",
          "evaluable",
          "scr15",
          "xg_per_corner",
          "dominant_zone",
          "main_taker",
          "example_event_ids",
          "snapshot"
        ],
        "title": "Pattern"
      },
      "Quality": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider",
            "default": "StatsBomb Open Data"
          },
          "season": {
            "type": "string",
            "title": "Season",
            "default": "LaLiga 2015/16"
          },
          "competition_id": {
            "type": "integer",
            "title": "Competition Id",
            "default": 11
          },
          "season_id": {
            "type": "integer",
            "title": "Season Id",
            "default": 27
          },
          "processed_at": {
            "type": "string",
            "title": "Processed At"
          },
          "source_manifest_sha256": {
            "type": "string",
            "title": "Source Manifest Sha256"
          },
          "rule_version": {
            "type": "string",
            "title": "Rule Version"
          },
          "coverage_matches": {
            "type": "integer",
            "title": "Coverage Matches"
          },
          "coverage_events": {
            "type": "integer",
            "title": "Coverage Events"
          },
          "excluded_sequences": {
            "type": "integer",
            "title": "Excluded Sequences"
          },
          "excluded_spatial": {
            "type": "integer",
            "title": "Excluded Spatial"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "processed_at",
          "source_manifest_sha256",
          "rule_version",
          "coverage_matches",
          "coverage_events",
          "excluded_sequences",
          "excluded_spatial",
          "limitations"
        ],
        "title": "Quality"
      },
      "Report": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "deterministic",
              "gemini"
            ],
            "title": "Mode"
          },
          "fallback_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Reason"
          },
          "plan": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Plan"
          },
          "input": {
            "$ref": "#/components/schemas/ReportInput"
          },
          "narrative": {
            "$ref": "#/components/schemas/Narrative"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode",
          "fallback_reason",
          "plan",
          "input",
          "narrative",
          "sources"
        ],
        "title": "Report"
      },
      "ReportInput": {
        "properties": {
          "rival": {
            "type": "string",
            "title": "Rival"
